    "content": {
      "it": [
        {
          "id": "6a8c615246868470070fdd2f",
          "variant": "small",
          "bg": "primary",
          "backgroundImage": null,
          "backgroundImageForMobile": null,
          "showBreadcrumb": true,
          "title": "Piattaforme abilitanti",
          "paragraph": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "I servizi individuati dal Piano Triennale che rendono possibile l’ecosistema digitale della Pubblica Amministrazione",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr"
                }
              ],
              "direction": "ltr"
            }
          },
          "blockName": null,
          "blockType": "hero",
          "cta": []
        },
        {
          "id": "6a8c615246868470070fdd31",
          "bg": "default",
          "heading": "h2",
          "blockName": null,
          "blockType": "text-only",
          "text": [
            {
              "id": "6a8c615246868470070fdd30",
              "title": "Le fondamenta dei servizi digitali della PA",
              "paragraph": {
                "root": {
                  "type": "root",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "type": "paragraph",
                      "format": "",
                      "indent": 0,
                      "version": 1,
                      "children": [
                        {
                          "mode": "normal",
                          "text": "Nel percorso di trasformazione digitale della PA, alcune infrastrutture svolgono un ruolo centrale: rendono possibile la costruzione, l’integrazione e l’evoluzione dei servizi digitali.",
                          "type": "text",
                          "style": "",
                          "detail": 0,
                          "format": 0,
                          "version": 1
                        }
                      ],
                      "direction": "ltr"
                    },
                    {
                      "type": "paragraph",
                      "format": "",
                      "indent": 0,
                      "version": 1,
                      "children": [
                        {
                          "mode": "normal",
                          "text": "Mettono a disposizione funzionalità comuni come identità digitale, pagamenti, dati e notifiche che le amministrazioni possono utilizzare nei propri servizi, seguendo regole e pratiche condivise.",
                          "type": "text",
                          "style": "",
                          "detail": 0,
                          "format": 0,
                          "version": 1
                        }
                      ],
                      "direction": "ltr"
                    }
                  ],
                  "direction": "ltr"
                }
              },
              "blockName": null,
              "blockType": "text-block",
              "cta": []
            }
          ]
        },
        {
          "id": "6a8c615246868470070fdd33",
          "blockName": null,
          "blockType": "catalogue-feed",
