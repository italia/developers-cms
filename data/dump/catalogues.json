        {
          "id": "6a8c615246868470070fdd2a",
          "variant": "small",
          "bg": "primary",
          "backgroundImage": null,
          "backgroundImageForMobile": null,
          "showBreadcrumb": true,
          "title": "Enabling platforms",
          "paragraph": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "The services identified in the Three-Year Plan that enable the public administration’s digital ecosystem.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr"
                }
              ],
              "direction": "ltr"
            }
          },
          "blockName": null,
          "blockType": "hero",
          "cta": []
        },
        {
          "id": "6a8c615246868470070fdd2c",
          "bg": "default",
          "heading": "h2",
          "blockName": null,
          "blockType": "text-only",
          "text": [
            {
              "id": "6a8c615246868470070fdd2b",
              "title": "The Foundation of Digital Services in the Public Administration",
              "paragraph": {
                "root": {
                  "type": "root",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "type": "paragraph",
                      "format": "",
                      "indent": 0,
                      "version": 1,
                      "children": [
                        {
                          "mode": "normal",
                          "text": "In the public sector’s digital transformation, certain infrastructures play a central role: they enable the creation, integration, and evolution of digital services.",
                          "type": "text",
                          "style": "",
                          "detail": 0,
                          "format": 0,
                          "version": 1
                        }
                      ],
                      "direction": "ltr"
                    },
                    {
                      "type": "paragraph",
                      "format": "",
                      "indent": 0,
                      "version": 1,
                      "children": [
                        {
                          "mode": "normal",
                          "text": "They provide common functionalities—such as digital identity, payments, data, and notifications—that government agencies can use in their own services, following shared rules and practices.",
                          "type": "text",
                          "style": "",
                          "detail": 0,
                          "format": 0,
                          "version": 1
                        }
                      ],
                      "direction": "ltr"
                    }
                  ],
                  "direction": "ltr"
                }
              },
              "blockName": null,
              "blockType": "text-block",
              "cta": []
            }
          ]
        },
